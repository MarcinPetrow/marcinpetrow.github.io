---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDate, publishedPosts } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={`${post.data.title} — Marcin Petrów`} description={post.data.description}>
  <article class="article"><a class="back" href="/">← All notes</a><p class="eyebrow article-date"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time></p><h1>{post.data.title}</h1><p class="article-description">{post.data.description}</p>{post.data.tags.length > 0 && <p class="tags">{post.data.tags.join(" / ")}</p>}<div class="prose"><Content /></div></article>
</Base>
