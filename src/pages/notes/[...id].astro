---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDate, publishedPosts, tagSlug } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const posts = await publishedPosts();
const index = posts.findIndex((item) => item.id === post.id);
const newerPost = posts[index - 1];
const olderPost = posts[index + 1];
---
<Base title={`${post.data.title} — Marcin Petrów`} description={post.data.description}>
  <article class="article"><a class="back" href="/">← All notes</a><p class="eyebrow article-date"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time></p><h1>{post.data.title}</h1><p class="article-description">{post.data.description}</p>{post.data.tags.length > 0 && <p class="tags">{post.data.tags.map((tag) => <a href={`/tags/${tagSlug(tag)}/`}>{tag}</a>)}</p>}<div class="prose"><Content /></div><nav class="post-navigation" aria-label="Post navigation">{newerPost ? <a href={`/notes/${newerPost.id}/`}><span>← Newer note</span>{newerPost.data.title}</a> : <span />}{olderPost ? <a class="next" href={`/notes/${olderPost.id}/`}><span>Older note →</span>{olderPost.data.title}</a> : <span />}</nav></article>
</Base>
