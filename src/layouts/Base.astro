---
import "../styles/global.css";

interface Props { title?: string; description?: string }
const { title = "Marcin Petrów", description = "Notes, experiments, and things in progress." } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f4ef" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Marcin Petrów — Notes" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Marcin Petrów — Notes" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/social-card.svg", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/social-card.svg", Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <div class="shell">
      <header class="header">
        <a class="wordmark" href="/" aria-label="Marcin Petrów home"><span class="mark">mp<span>.</span></span><span>Marcin Petrów</span></a>
        <nav aria-label="Main navigation"><a href="/">Notes</a><a href="/archive/">Archive</a><a href="/tags/">Topics</a><a href="/about/">About</a></nav>
      </header>
      <main id="content"><slot /></main>
      <footer class="footer"><span>© {new Date().getUTCFullYear()} Marcin Petrów</span><span><a href="/rss.xml">RSS</a><a href="/about/">Contact</a></span></footer>
    </div>
  </body>
</html>
